# Connection string Postgres/Supabase (wajib).
# Supabase → Project Settings → Database → Connection string → Connection pooling
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Opsional: kunci penandatangan cookie sesi (ganti di produksi).
# SESSION_SECRET="ganti-dengan-string-acak-panjang"

# Opsional: jumlah koneksi per instance serverless (default 3).
# DATABASE_POOL_MAX=3
